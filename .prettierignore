# Prettier owns Markdown and YAML only.
# Everything Biome formats — TS, JS, JSON — is off limits, so the two
# formatters can never disagree about the same file.
*.ts
*.tsx
*.js
*.mjs
*.cjs
*.json
*.jsonc

node_modules/
dist/
coverage/
packages/db/migrations/

# Vendored Solidity dependencies (forge-std submodule). Formatting these would
# dirty the submodule working tree on every `bun run format`.
packages/contracts/*/lib/
bun.lock
bun.lockb

# Auto-generated session memory, not source.
.remember/
