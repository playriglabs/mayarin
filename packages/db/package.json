{
  "name": "@mayarin/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "generate": "bun --env-file=../../.env run drizzle-kit generate",
    "migrate": "bun --env-file=../../.env run src/migrate.ts",
    "studio": "bun --env-file=../../.env run drizzle-kit studio"
  },
  "dependencies": {
    "@mayarin/auth": "workspace:*",
    "@mayarin/catalog": "workspace:*",
    "@mayarin/chain": "workspace:*",
    "@mayarin/clearing": "workspace:*",
    "@mayarin/compliance": "workspace:*",
    "@mayarin/ledger": "workspace:*",
    "@mayarin/payment-intent": "workspace:*",
    "@mayarin/qr-parser": "workspace:*",
    "@mayarin/shared": "workspace:*",
    "drizzle-orm": "^0.38.3",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@mayarin/provider-mock": "workspace:*",
    "@mayarin/settlement": "workspace:*",
    "drizzle-kit": "^0.30.1"
  }
}
