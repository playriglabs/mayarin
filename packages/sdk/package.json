{
  "name": "@mayarin/sdk",
  "version": "0.1.0-next.1",
  "description": "TypeScript client for Mayarin: commerce, payments, webhooks and x402 gates.",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./browser": "./src/browser.ts",
    "./x402/connect": "./src/x402-connect.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsdown",
    "stage": "bun run build && bun run ../../scripts/stage-npm.ts packages/sdk"
  },
  "dependencies": {
    "@mayarin/chain": "workspace:*",
    "@mayarin/qr-parser": "workspace:*",
    "@mayarin/x402": "workspace:*"
  },
  "devDependencies": {
    "@mayarin/api": "workspace:*",
    "publint": "^0.3.25",
    "tsdown": "^0.23.0"
  }
}
