node_modules/
dist/
# Prerender's throwaway SSR bundle; the build removes it, a failed build may not.
dist-ssr/
build/
coverage/

.env
.env.*
!.env.example
.env.testnet

*.log
.DS_Store
.idea/

# Editor config is shared so everyone gets the same formatters; personal
# settings stay out.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Same rule for agents: the shared skills are versioned, the local plugin and
# permission choices are not.
.claude/*
!.claude/skills/
.claude/settings.local.json

.astro
.wrangler/
.bun/
bun.lockb.bak

# Turborepo local cache + artifacts
.turbo
node_modules/.cache/turbo

# Foundry build artifacts. `lib/` is NOT ignored — forge-std is a git submodule,
# pinned by commit in .gitmodules.
packages/contracts/*/out/
packages/contracts/*/cache/
packages/contracts/*/broadcast/
__pycache__/

SCALE_UP.md
