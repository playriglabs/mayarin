node_modules/
dist/
build/
coverage/

.env
.env.*
!.env.example

*.log
.DS_Store
.idea/

# Editor config is shared so everyone gets the same formatters; personal
# settings stay out.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Same rule for agents: the shared skills are versioned, the local plugin and
# permission choices are not.
.claude/*
!.claude/skills/
.claude/settings.local.json

.astro
.bun/
bun.lockb.bak

# Turborepo local cache + artifacts
.turbo
node_modules/.cache/turbo

# Foundry build artifacts + soldeer-vendored deps (soldeer.lock is committed)
packages/contracts/*/out/
packages/contracts/*/cache/
packages/contracts/*/dependencies/
