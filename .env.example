# --- API ---
PORT=3000
NODE_ENV=development

# --- Storage ---
DATABASE_URL=postgres://mayarin:mayarin@localhost:5433/mayarin

# --- Clearing ---
# Asset every payment is cleared and settled in.
SETTLEMENT_ASSET=IDRX
# Mayarin fee taken from each cleared payment, in basis points (100 = 1.00%).
FEE_BASIS_POINTS=50
# Settlement adapter used when a payment intent does not pin one.
DEFAULT_SETTLEMENT_PROVIDER=mock
# Lifetime of a payment intent, in seconds.
PAYMENT_INTENT_TTL_SECONDS=900

# Minor units of the target asset per one whole unit of the source asset.
# 1 IDR = 100 minor units of IDRX (both are 2-decimal), i.e. a 1:1 peg.
# Replaced by the liquidity router's live price discovery in Phase 2.
EXCHANGE_RATES={"IDR/IDRX":"100"}

# How a payment becomes funded.
#   auto   - treat a payment as funded when it reaches PAYMENT_PENDING.
#            Phase 1 stand-in for the wallet watcher Phase 2 introduces.
#   manual - wait until the asset receipt is recorded explicitly.
ASSET_RECEIPT_MODE=auto

# How a payment rail is executed.
#   deposit-match      - watch a per-intent deposit address (fallback path).
#   on-chain-contract  - settle atomically via PaymentRouter.sol (Phase 3; the
#                        engine fails a contract-path payment until then).
EXECUTION_PATH=deposit-match

# --- Providers ---
# Shared secret the mock adapter verifies inbound webhook signatures against.
# Unset disables signature checking.
MOCK_WEBHOOK_SECRET=whsec_mayarin_dev
