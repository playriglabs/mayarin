# =============================================================================
# Mayarin — environment
#
# Every address below in the Base Sepolia section was verified on-chain against
# https://sepolia.base.org before being written here. Verify again before
# mainnet: a wrong token address moves real value to the wrong place, and a
# wrong `PERMIT2` cannot be fixed without redeploying the router.
# =============================================================================

# --- API ---
PORT=3000
NODE_ENV=development

# --- Storage ---
DATABASE_URL=postgres://mayarin:mayarin@localhost:5433/mayarin

# --- Clearing ---
# Fallback settlement asset. A merchant's own `settlement_asset` outranks it;
# this applies only to a merchant that has not chosen one.
SETTLEMENT_ASSET=IDRX
# Mayarin fee taken from each cleared payment, in basis points (100 = 1.00%).
FEE_BASIS_POINTS=50
# Settlement adapter used when a payment intent does not pin one.
DEFAULT_SETTLEMENT_PROVIDER=mock
# Lifetime of a payment intent, in seconds.
PAYMENT_INTENT_TTL_SECONDS=900

# Minor units of the target asset per one whole unit of the source asset.
# Only used when the quote layer is off — it is the development stand-in for
# live price discovery.
EXCHANGE_RATES={"IDR/IDRX":"100"}

# How a payment becomes funded.
#   auto   - treat a payment as funded when it reaches PAYMENT_PENDING.
#            Refused at boot when the chain layer is on.
#   manual - wait until the asset receipt is recorded explicitly.
ASSET_RECEIPT_MODE=manual

# Default execution path for an intent that names a payment rail. Per-request
# `executionPath` on POST /payment-intents outranks it — which is what a
# checkout needs, because a payer who connects a wallet and a payer who pastes
# an address into an exchange withdrawal cannot share one setting.
#   deposit-match      - per-intent deposit address + wallet watcher. The only
#                        path a scanning or custodial payer can take.
#   on-chain-contract  - PaymentRouter.sol receives, swaps and settles
#                        atomically. Needs the payer to connect a wallet.
EXECUTION_PATH=deposit-match

# =============================================================================
# Chain layer — deposit addresses, wallet watcher, settlement indexer
# Off entirely unless CHAIN_ENABLED=true.
# =============================================================================
CHAIN_ENABLED=false

# One RPC per chain. Alchemy, Infura or the public endpoint all work.
CHAIN_RPC_URLS={"base-sepolia":"https://base-sepolia.g.alchemy.com/v2/YOUR_KEY"}

# ERC-20 address per chain and asset. VERIFIED: Circle USDC on Base Sepolia,
# symbol "USDC", 6 decimals.
CHAIN_ASSETS={"base-sepolia":{"USDC":"0x036CbD53842c5426634e7929541eC2318f3dCF7e"}}

# Confirmations before a deposit may fund a payment, and before a settlement
# may complete one. Base blocks are ~2s, so 2 is ~4 seconds.
CHAIN_CONFIRMATIONS={"base-sepolia":2}

# Block to scan from when a chain has no cursor yet. Set this to the router's
# deploy block — 0 makes the first pass walk the chain from genesis.
CHAIN_START_BLOCKS={"base-sepolia":"0"}

# Watch-only extended public key. The API derives deposit addresses from it and
# cannot spend from them: a bug in the watch path has no key to move funds with.
DEPOSIT_XPUB=

WATCHER_INTERVAL_MS=15000
WATCHER_BLOCK_RANGE=2000
WATCHER_RETENTION_SECONDS=86400
# How far past the confirmation depth to keep probing for a reorg, as a
# multiple of it. Past depth × window a deposit is treated as final.
WATCHER_REORG_WATCH_WINDOW=2

# =============================================================================
# Quote layer — venue pricing, oracle deviation guard, order signing
# Off by default: a deployment without a venue, an oracle and a signer should
# boot without a quote engine rather than with a half-built one.
# =============================================================================
QUOTE_ENABLED=false

# Venues to price against, in preference order.
#   "0x"      aggregator, routes multi-hop. MAINNET ONLY — the 0x Swap API does
#             not serve Base Sepolia, so it cannot be the testnet venue.
#   "uniswap" one configured pool per pair, no routing of its own.
#   "lifi"    prices but cannot route; never the only venue on the contract path.
QUOTE_VENUES=["uniswap"]

QUOTE_ORACLE=pyth
# How far the venue price may sit from the oracle before the quote fails.
QUOTE_DEVIATION_BPS=100
QUOTE_MAX_REFERENCE_AGE_SECONDS=60

# Pairs that are the same currency in two representations, so the fiat leg is a
# decimal rescale rather than an exchange rate. Declared by the deployment,
# never inferred: whether a stablecoin holds its peg is a judgement about an
# issuer. NOTE: a pegged pair reads no price at all, so no guard can see a
# broken peg — see docs/threat-model.md and issue #71.
QUOTE_PEGGED_PAIRS=["IDR/IDRX"]
QUOTE_FX_MAX_AGE_SECONDS=300

# Slippage bound folded into the payer's displayed estimate, and the quote's TTL.
QUOTE_SLIPPAGE_BPS=50
QUOTE_TTL_SECONDS=120

# --- Order signing ---
# The address behind this key is what PaymentRouter verifies every order
# against. It MUST equal the `SIGNER` passed at deploy, or every payment fails
# with `InvalidSigner` and fixing it costs a timelocked `setSigner`.
#   local   - QUOTE_SIGNER_PRIVATE_KEY. Development only.
#   turnkey - policy-gated remote signing.
QUOTE_SIGNER=local
QUOTE_SIGNER_PRIVATE_KEY=
TURNKEY_ORGANIZATION_ID=
TURNKEY_SIGN_WITH=
TURNKEY_SIGNER_ADDRESS=
TURNKEY_API_PUBLIC_KEY=
TURNKEY_API_PRIVATE_KEY=

# --- Oracle feeds ---
# Pyth price feed ids per pair.
PYTH_FEEDS={}
# Chainlink aggregator addresses per pair.
CHAINLINK_FEEDS={}

# --- Uniswap venue ---
# QuoterV2 per chain — the read that prices a pair.
# VERIFIED on Base Sepolia (factory 0x4752ba5DBc23f44D87826276BF6Fd6b1C372aD24).
UNISWAP_QUOTERS={"base-sepolia":"0xC5290058841028F1614F3A6F0F5816cAd0df5E27"}

# One pool per pair: chain, both token addresses, and the fee tier that carries
# it. The adapter does no routing of its own, so a pair with no pool here has no
# price. `0x4200...0006` is WETH on Base Sepolia (confirmed via
# SwapRouter02.WETH9()).
UNISWAP_POOLS={"ETH/USDC":{"chain":"base-sepolia","tokenIn":"0x4200000000000000000000000000000000000006","tokenOut":"0x036CbD53842c5426634e7929541eC2318f3dCF7e","fee":3000}}

# --- 0x venue (mainnet only) ---
ZERO_EX_API_KEY=
ZERO_EX_CHAIN_ID=8453
ZERO_EX_PAIRS={}

# =============================================================================
# Contract path — PaymentRouter
# =============================================================================
CONTRACT_PATH_ENABLED=false

# Deployed PaymentRouter per chain, from the deploy script's output.
PAYMENT_ROUTERS={"base-sepolia":"0x0000000000000000000000000000000000000000"}

# SwapRouter02 per chain — the router the calldata builder targets. It must also
# be whitelisted on the contract itself via ConfigurePaymentRouter.s.sol, or
# every swap payment reverts `RouterNotWhitelisted`.
# VERIFIED on Base Sepolia.
UNISWAP_SWAP_ROUTERS={"base-sepolia":"0x94cC0AaC535CCDB3C01d6787D6413C739ae12bc4"}

# There is no knob for the expiry grace past the quote deadline; the engine
# defaults to 60s and the composition root does not override it.

# =============================================================================
# Deploy — forge script env (packages/contracts/payment-router)
# Not read by the API. Kept here so one file describes the whole deployment.
# =============================================================================

# BASE_SEPOLIA_RPC_URL=https://base-sepolia.g.alchemy.com/v2/YOUR_KEY
# ETHERSCAN_API_KEY=            # basescan.org, for --verify

# Timelock proposer + executor + admin. A testnet may use the deployer EOA; a
# production deployment must not.
# MULTISIG=0x...
# GUARDIAN=0x...                # instant-pause holder, separate from MULTISIG
# FEE_RECIPIENT=0x...           # treasury Safe — never a merchant address
# SIGNER=0x...                  # MUST equal the API's order-signing address

# Settlement ERC-20s whitelisted in the constructor. At least one is required,
# and adding another later costs the full timelock delay.
# SETTLEMENT_TOKENS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Config-change delay in seconds. 0 on a testnet: every post-deploy whitelist
# waits this long, so the 48h default turns a deploy into a two-day gate before
# the first payment can be tested.
# TIMELOCK_DELAY=0

# --- ConfigurePaymentRouter.s.sol, run immediately after the deploy ---
# The constructor whitelists settlement assets only. Without this step the
# first swap payment reverts `RouterNotWhitelisted`.
# TIMELOCK=0x...                # from the deploy output
# PAYMENT_ROUTER=0x...          # from the deploy output
# DEX_ROUTERS=0x94cC0AaC535CCDB3C01d6787D6413C739ae12bc4
# INPUT_ASSETS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# --- Sanity (blog CMS) ---
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_READ_TOKEN=

# --- Providers ---
# Shared secret the mock adapter verifies inbound webhook signatures against.
MOCK_WEBHOOK_SECRET=whsec_mayarin_dev
