---
import { getCollection } from "astro:content";
import Base from "../layouts/base.astro";
import PostCard from "../components/post-card.astro";

const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
  );
---

<Base title="Mayarin" description="The Mayarin blog — notes on programmable crypto-commerce infrastructure.">
  <section class="mx-auto max-w-3xl px-6 py-16">
    <header class="mb-10">
      <h1 class="font-[var(--font-display)] text-5xl font-normal tracking-tight">
        Blog
      </h1>
      <p class="mt-3 max-w-xl text-[var(--color-slate)]">
        Notes on programmable crypto-commerce infrastructure — clearing,
        settlement, the chain layer, and how merchants price in fiat and settle
        in stablecoin.
      </p>
    </header>
    {
      posts.length === 0 ? (
        <p class="text-[var(--color-slate)]">No posts yet.</p>
      ) : (
        posts.map((post) => <PostCard post={post} />)
      )
    }
  </section>
</Base>