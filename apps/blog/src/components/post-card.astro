---
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { title, description, pubDate, tags } = post.data;
const dateLabel = pubDate.toLocaleDateString("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
});
const href = `/blog/${post.id}/`;
---

<article class="border-b border-[var(--color-line)] py-8">
  <a href={href} class="group block">
    <p class="text-xs text-[var(--color-slate)]">{dateLabel}</p>
    <h2
      class="mt-2 font-[var(--font-display)] text-2xl font-normal tracking-tight group-hover:text-[var(--color-forest)]"
    >
      {title}
    </h2>
    <p class="mt-2 text-[var(--color-slate)]">{description}</p>
    {
      tags.length > 0 && (
        <ul class="mt-3 flex flex-wrap gap-2">
          {tags.map((tag) => (
            <li class="text-xs text-[var(--color-slate)]">#{tag}</li>
          ))}
        </ul>
      )
    }
  </a>
</article>