---
import type { CollectionEntry } from "astro:content";
import Base from "./base.astro";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { title, pubDate, description, author, thumbnailUrl, tags } = post.data;
const dateLabel = pubDate.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<Base title={title} description={description}>
  <article class="mx-auto max-w-3xl px-6 py-16">
    <a
      href="/blog/"
      class="text-sm text-[var(--color-slate)] hover:text-[var(--color-ink)]"
      >← All posts</a
    >
    <header class="mt-6 mb-10">
      {
        thumbnailUrl && (
          <img
            src={thumbnailUrl}
            alt=""
            class="mb-8 aspect-[2/1] w-full rounded-sm object-cover"
          />
        )
      }
      <h1 class="font-[var(--font-display)] text-4xl font-normal tracking-tight">
        {title}
      </h1>
      <p class="mt-3 text-[var(--color-slate)]">{dateLabel} · By {author}</p>
      {
        tags.length > 0 && (
          <ul class="mt-4 flex flex-wrap gap-2">
            {tags.map((tag) => (
              <li class="rounded-full border border-[var(--color-line)] px-3 py-0.5 text-xs text-[var(--color-slate)]">
                {tag}
              </li>
            ))}
          </ul>
        )
      }
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
</Base>
