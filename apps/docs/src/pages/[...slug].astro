---
import { render } from "astro:content";
import type { TOCItemType } from "fumadocs-core/toc";
import defaultMdxComponents from "fumadocs-ui/mdx";
import Card from "@/components/card.astro";
import Cards from "@/components/cards.astro";
import { Docs } from "@/components/docs";
import Layout from "@/components/layout.astro";
import TypeTable from "@/components/type-table.astro";
import { getPageImageUrl, source } from "@/lib/source";
import "@/styles/global.css";

const slugs = typeof Astro.params.slug === "string" ? Astro.params.slug.split("/") : [];
const page = source.getPage(slugs);
// A rewrite, not a redirect: the reader keeps the URL they asked for, the
// response carries 404, and — crucially — `/404` itself no longer resolves
// through this catch-all, which used to redirect it to itself forever.
if (page === undefined) return Astro.rewrite("/404");

const authoredPage = page.data.type === "docs" ? page.data : undefined;
const apiPage = page.data.type === "api" ? page.data : undefined;
const authored = authoredPage === undefined ? undefined : await render(authoredPage._raw);
const apiProps = apiPage === undefined ? undefined : apiPage.getOpenAPIPageProps();
const toc: TOCItemType[] = authoredPage !== undefined
  ? (authored?.headings ?? []).map((heading) => ({
      depth: heading.depth,
      title: heading.text,
      url: `#${heading.slug}`,
    }))
  : (apiPage?.toc ?? []);
const title = `${page.data.title} — Mayarin Docs`;
const description = page.data.description ?? "Build programmable clearing with Mayarin.";
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// Per-page OG image is generated by src/pages/og/docs/[...slug]/image.jpeg.ts.
// Crawlers need an absolute URL, so resolve it against the site origin.
const ogImage = new URL(getPageImageUrl(page), Astro.site).href;

// `TechArticle` rather than `WebPage`: every page here documents how to use
// something, which is what lets a search engine offer a developer-docs result
// instead of a generic one. `isPartOf` ties the set together so the site is one
// documentation surface rather than N unrelated pages.
const structuredData = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  headline: page.data.title,
  description,
  url: canonical,
  image: ogImage,
  inLanguage: "en",
  isPartOf: {
    "@type": "WebSite",
    name: "Mayarin Docs",
    url: Astro.site?.href ?? "https://docs.mayarin.xyz/",
  },
  publisher: {
    "@type": "Organization",
    name: "Mayarin",
    url: "https://mayarin.xyz",
  },
};
---

<Layout>
  <Fragment slot="head">
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {/* Alt text travels with the card, so a screen reader meets the picture too. */}
    <meta
      property="og:image:alt"
      content={`${page.data.title} — Mayarin documentation`}
    />
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData)}
    />
  </Fragment>
  <Docs
    tree={source.getPageTree()}
    pathname={Astro.url.pathname}
    params={Astro.params}
    page={{ toc, tableOfContent: { style: "clerk" } }}
    apiProps={apiProps}
    client:load
  >
    {
      authoredPage !== undefined && (
        <>
          <header class="mb-10 border-b border-fd-border pb-8">
            <h1 class="docs-title text-2xl md:text-3xl">{page.data.title}</h1>
            {page.data.description && (
              <p class="mt-4 max-w-3xl text-lg leading-8 text-fd-muted-foreground">
                {page.data.description}
              </p>
            )}
          </header>
          <div class="prose flex-1">
            {
              authored && (
                <authored.Content
                  components={{ ...defaultMdxComponents, TypeTable, Card, Cards }}
                />
              )
            }
          </div>
        </>
      )
    }
  </Docs>
</Layout>
