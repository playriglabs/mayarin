{
  "name": "@mayarin/docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vocs dev",
    "build": "vocs build",
    "preview": "vocs preview",
    "typecheck": "tsc --noEmit",
    "generate": "bun run scripts/generate-openapi.ts",
    "openapi:check": "bun run scripts/generate-openapi.ts && git diff --exit-code -- src/lib/openapi.json",
    "generate:types": "bun run scripts/generate-type-tables.ts",
    "types:check": "bun run scripts/generate-type-tables.ts --check",
    "generate:api-pages": "bun run scripts/generate-api-pages.ts",
    "api-pages:check": "bun run scripts/generate-api-pages.ts --check"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.2.2",
    "vocs": "^2.8.5",
    "waku": "1.0.0-rc.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^5.7.3"
  }
}
