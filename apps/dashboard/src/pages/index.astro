---
import Protected from "../layouts/dashboard.astro";
---

<Protected>
  <section class="flex flex-col gap-6">
    <div>
      <h1 class="text-2xl font-semibold text-stone-800">Dashboard</h1>
      <p class="text-sm text-stone-500">Skeleton — data integration comes in a later task.</p>
    </div>

    <div class="grid gap-4 sm:grid-cols-3">
      <article class="rounded-lg border border-stone-200 bg-white p-5">
        <h2 class="text-sm font-medium text-stone-500">Payment Explorer</h2>
        <p class="mt-2 h-16 animate-pulse rounded bg-stone-100" />
      </article>
      <article class="rounded-lg border border-stone-200 bg-white p-5">
        <h2 class="text-sm font-medium text-stone-500">Timeline</h2>
        <p class="mt-2 h-16 animate-pulse rounded bg-stone-100" />
      </article>
      <article class="rounded-lg border border-stone-200 bg-white p-5">
        <h2 class="text-sm font-medium text-stone-500">Settlement Status</h2>
        <p class="mt-2 h-16 animate-pulse rounded bg-stone-100" />
      </article>
    </div>
  </section>
</Protected>
