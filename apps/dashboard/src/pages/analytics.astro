---
import Analytics from "../components/analytics.tsx";
import Protected from "../layouts/dashboard.astro";

const periodEnd = new Date();
const periodStart = new Date(periodEnd);
periodStart.setUTCDate(periodStart.getUTCDate() - 29);
const periodDate = new Intl.DateTimeFormat("en-US", {
  month: "short",
  day: "numeric",
  timeZone: "UTC",
});
const periodLabel = `${periodDate.format(periodStart)} – ${periodDate.format(periodEnd)}`;
---

<Protected title="Analytics">
  <header class="mb-8 flex flex-wrap items-start justify-between gap-5">
    <div class="flex flex-col">
      <h1 class="font-sans text-[28px] font-medium tracking-[-0.025em] text-foreground">
        Analytics
      </h1>
      <p class="text-base text-muted-foreground mt-3">
        Payments and settlement performance over the last thirty days.
      </p>
    </div>
    <div
      role="group"
      aria-label="Analytics reporting context"
      class="flex flex-wrap items-center gap-2"
    >
      <span class="inline-flex min-h-11 items-center rounded-lg border border-border bg-card px-4 text-sm text-foreground">
        Daily
      </span>
      <span class="inline-flex min-h-11 items-center rounded-lg border border-border bg-card px-4 text-sm text-foreground tabular-nums">
        {periodLabel}
      </span>
      <span class="inline-flex min-h-11 items-center rounded-lg border border-border bg-card px-4 text-sm text-foreground">
        All payments
      </span>
    </div>
  </header>
  <Analytics client:load />
</Protected>
