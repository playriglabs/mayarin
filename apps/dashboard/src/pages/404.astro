---
import "../styles/global.css";
import SocialMeta from "../components/social-meta.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="description" content="The requested Mayarin dashboard page was not found." />
    <title>Page not found</title>
    <SocialMeta />
    <link rel="icon" href="/favicon.ico" sizes="48x48" type="image/x-icon" />
    <link rel="icon" href="/favicon-16x16.png" sizes="16x16" type="image/png" />
    <link rel="icon" href="/favicon-32x32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link
      rel="preload"
      href="/fonts/PPNeueMontreal-VariableUpright.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <script is:inline>
      const storedTheme = localStorage.getItem("mayarin-theme");
      const systemTheme = window.matchMedia("(prefers-color-scheme: dark)").matches
        ? "dark"
        : "light";
      document.documentElement.dataset.theme =
        storedTheme === "light" || storedTheme === "dark" ? storedTheme : systemTheme;
      document
        .querySelector('meta[name="theme-color"]')
        ?.setAttribute(
          "content",
          document.documentElement.dataset.theme === "light" ? "#ffffff" : "#0a0a0a",
        );
    </script>
  </head>
  <body class="min-h-svh bg-background text-foreground">
    <main class="flex min-h-svh items-center justify-center px-6 py-12">
      <div class="w-full max-w-md text-center">
        <p class="font-mono text-xs text-muted-foreground">404</p>
        <h1 class="mt-4 text-[clamp(1.75rem,4vw,2.5rem)] font-medium leading-tight tracking-tight">
          Page not found
        </h1>
        <p class="mt-4 text-base leading-6 text-muted-foreground">
          This page may have moved, or the address is incorrect.
        </p>
        <a
          href="/"
          class="mt-8 inline-flex min-h-12 items-center justify-center rounded-lg bg-primary px-6 text-sm font-medium text-primary-foreground transition-opacity hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring"
        >
          Back to dashboard
        </a>
      </div>
    </main>
  </body>
</html>
