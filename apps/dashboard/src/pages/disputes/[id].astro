---
import DisputeCase from "../../components/dispute-case.tsx";
import { PageHeader } from "../../components/page-header.tsx";
import Protected from "../../layouts/dashboard.astro";

const { id } = Astro.params;
if (id === undefined) return Astro.redirect("/disputes");
---

<Protected title="Dispute">
  <PageHeader title="Dispute" description="Read both sides, then decide from the arbiter wallet." />
  <DisputeCase id={id} client:load />
</Protected>
