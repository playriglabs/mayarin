---
/**
 * Authenticated shell: sidebar on desktop, a scrollable rail above the content
 * on narrow viewports. Auth gating itself lives in `src/middleware.ts`; the
 * guard below only narrows `user` for TypeScript.
 */
import LogoutButton from "../components/logout-button.tsx";
import SideNav from "../components/side-nav.tsx";
import type { UserDto } from "../types/user";
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;

const user: UserDto | undefined = Astro.locals.user;
if (user === undefined) return Astro.redirect("/login");

const isAdmin = user.permissions.includes("admin:access");
const roleLabel = isAdmin ? "Administrator" : "Merchant";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Mayarin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500&display=swap"
    />
  </head>
  <body class="min-h-full">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-2 focus:top-2 focus:z-50 focus:bg-primary focus:px-3 focus:py-2 focus:text-sm focus:text-white"
    >
      Skip to content
    </a>

    <div class="flex min-h-screen flex-col md:flex-row">
      <aside
        class="flex shrink-0 flex-col border-b border-border bg-card md:sticky md:top-0 md:h-screen md:w-56 md:border-r md:border-b-0"
      >
        <div class="flex items-center justify-between gap-2 border-b border-border p-2">
          <a href="/" class="flex items-center gap-2 p-2 text-sm font-medium text-foreground">
            <span aria-hidden="true" class="inline-block size-1.5 bg-brand"></span>
            Mayarin
          </a>
        </div>

        <SideNav pathname={Astro.url.pathname} isAdmin={isAdmin} />

        <div class="mt-auto flex items-center justify-between gap-2 border-t border-border p-2">
          <div class="flex min-w-0 flex-col">
            <span class="truncate text-xs text-foreground">{user.email}</span>
            <span class="text-xs text-subtle-foreground">{roleLabel}</span>
          </div>
          <LogoutButton client:load />
        </div>
      </aside>

      <main id="main" class="min-w-0 flex-1 p-4 md:p-8">
        <div class="mx-auto flex max-w-5xl flex-col gap-6">
          <slot />
        </div>
      </main>
    </div>
  </body>
</html>
