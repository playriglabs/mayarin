---
/**
 * Authenticated shell: sidebar on desktop, a scrollable rail above the content
 * on narrow viewports. Auth gating itself lives in `src/middleware.ts`; the
 * guard below only narrows `user` for TypeScript.
 */
import { Avatar, Style } from "@dicebear/core";
import wavesDefinition from "@dicebear/styles/waves.json" with { type: "json" };
import {
  BuildingsIcon,
  InfoIcon,
  SignpostIcon,
  UserIcon,
  XIcon,
} from "@phosphor-icons/react";
import LogoutButton from "../components/logout-button.tsx";
import LiveUpdates from "../components/live-updates.tsx";
import { MfaStepUpHost } from "../components/mfa-step-up.tsx";
import NotificationBell from "../components/notification-bell.tsx";
import OnboardingTour from "../components/onboarding-tour.tsx";
import SidebarToggle from "../components/sidebar-toggle.tsx";
import SideNav from "../components/side-nav.tsx";
import ThemeToggle from "../components/theme-toggle.tsx";
import SocialMeta from "../components/social-meta.astro";
import Toaster from "../components/ui/toaster.tsx";
import "../styles/global.css";
import { getApiBase, originAuthHeaders } from "../lib/api/origin";
import type { SettingsResponse } from "../types/settings";
import type { UserDto } from "../types/user";

interface Props {
  title: string;
}

const { title } = Astro.props;

const user: UserDto | undefined = Astro.locals.user;
if (user === undefined) return Astro.redirect("/login");

// Open disputes beside "Disputes" in the sidebar (#313), so a merchant notices
// one without opening each payment. A failed read shows no count, not an error.
let openDisputes = 0;
if (user.permissions.includes("payments:read")) {
  try {
    const res = await fetch(`${getApiBase()}/escrow-disputes`, {
      headers: {
        cookie: `mayarin_session=${Astro.cookies.get("mayarin_session")?.value ?? ""}`,
        ...originAuthHeaders(),
      },
    });
    if (res.ok) openDisputes = ((await res.json()) as { open: number }).open;
  } catch {
    openDisputes = 0;
  }
}

// The company mark and name at the top of the sidebar. A failed read falls back
// to a neutral label, so the shell still renders.
let merchantName = "Your business";
let merchantLogo: string | null = null;
try {
  const res = await fetch(`${getApiBase()}/settings`, {
    headers: {
      cookie: `mayarin_session=${Astro.cookies.get("mayarin_session")?.value ?? ""}`,
      ...originAuthHeaders(),
    },
  });
  if (res.ok) {
    const { settings } = (await res.json()) as SettingsResponse;
    merchantName = settings.name;
    merchantLogo = settings.logoUrl;
  }
} catch {
  merchantLogo = null;
}

const isAdmin = user.permissions.includes("admin:access");
const roleLabel = isAdmin ? "Administrator" : "Merchant";
const wavesStyle = new Style(wavesDefinition);
const avatarSvg = new Avatar(wavesStyle, {
  seed: user.email,
  size: 88,
}).toString();

const avatarUrl = `data:image/svg+xml;charset=utf-8,${encodeURIComponent(avatarSvg)}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a0a0a" />
    <title>{title} — Mayarin</title>
    <SocialMeta />
    <link rel="icon" href="/favicon.ico" sizes="48x48" type="image/x-icon" />
    <link rel="icon" href="/favicon-16x16.png" sizes="16x16" type="image/png" />
    <link rel="icon" href="/favicon-32x32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link
      rel="preload"
      href="/fonts/PPNeueMontreal-VariableUpright.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <script is:inline>
      // Before first paint. A stored choice wins; a fresh browser follows the OS.
      const storedTheme = localStorage.getItem("mayarin-theme");
      const systemTheme = window.matchMedia("(prefers-color-scheme: dark)").matches
        ? "dark"
        : "light";
      document.documentElement.dataset.theme =
        storedTheme === "light" || storedTheme === "dark" ? storedTheme : systemTheme;
      document.documentElement.dataset.sidebarCollapsed =
        localStorage.getItem("mayarin-sidebar-collapsed") === "true" ? "true" : "false";
      document.documentElement.dataset.testnetNoticeDismissed =
        localStorage.getItem("mayarin-testnet-notice-v1-dismissed") === "true"
          ? "true"
          : "false";
      document
        .querySelector('meta[name="theme-color"]')
        ?.setAttribute(
          "content",
          document.documentElement.dataset.theme === "light" ? "#ffffff" : "#0a0a0a",
        );
    </script>
  </head>
  <body class="min-h-full">
    <a
      href="#main"
      class="fixed top-3 left-3 z-100 -translate-y-20 rounded-lg bg-primary px-3 py-2 text-primary-foreground transition-transform focus:translate-y-0"
    >
      Skip to content
    </a>
    <Toaster client:load />
    <!-- One host for every page: any action the API guards with an authenticator
         code asks through it, so a page cannot forget to mount its own. -->
    <MfaStepUpHost client:load />
    <LiveUpdates client:load />
    <OnboardingTour client:load userId={user.id} permissions={user.permissions} />


    <aside
      data-testnet-notice
      aria-label="Testnet notice"
      class="fixed inset-x-0 top-0 z-60 flex h-11 items-center justify-center border-b border-brand/20 bg-brand-muted px-14 text-brand"
    >
      <p class="flex min-w-0 items-center gap-2 text-center text-xs font-medium sm:text-sm">
        <InfoIcon size={16} weight="bold" aria-hidden="true" className="shrink-0" />
        <span class="truncate">
          <strong class="font-medium">Mayarin Testnet {" "}</strong>
          — Transactions use test assets and have no real-world value.
        </span>
      </p>
      <button
        type="button"
        data-testnet-notice-close
        aria-label="Dismiss testnet notice"
        class="absolute right-0 top-0 flex cursor-pointer size-11 items-center justify-center text-brand/70 transition-colors hover:bg-brand/10 hover:text-brand focus-visible:outline-2 focus-visible:outline-offset-[-3px] focus-visible:outline-ring"
      >
        <XIcon size={17} weight="regular" aria-hidden="true" />
      </button>
    </aside>

    <button
      type="button"
      data-sidebar-backdrop
      class="app-scrim fixed inset-0 z-40 md:hidden"
      aria-label="Close navigation menu"
      tabindex="-1"
    ></button>

    <div data-dashboard-frame class="flex min-h-dvh bg-sidebar pt-11 md:flex-row">
      <!-- The landing's dark tone, brought into the product as its anchor. -->
      <aside
        id="dashboard-sidebar"
        data-sidebar
        data-tone="dark"
        class="fixed top-11 bottom-0 left-0 z-50 flex w-[min(18rem,calc(100vw-3rem))] shrink-0 -translate-x-full flex-col bg-sidebar text-sidebar-foreground md:sticky md:top-11 md:h-[calc(100dvh-2.75rem)] md:w-72 md:translate-x-0"
      >
        <div
          data-sidebar-header
          class="flex h-16 items-center justify-between gap-1 px-3"
        >
          <div data-sidebar-logo class="flex min-h-11 min-w-0 flex-1 items-center gap-x-3 gap-y-4 px-2">
            {
              merchantLogo === null ? (
                <span class="flex size-9 shrink-0 items-center justify-center rounded-lg bg-sidebar-accent text-sidebar-muted-foreground">
                  <BuildingsIcon size={20} weight="regular" aria-hidden="true" />
                </span>
              ) : (
                <img
                  src={merchantLogo}
                  alt="merchant-logo"
                  aria-hidden="true"
                  width="36"
                  height="36"
                  class="size-9 shrink-0 rounded-lg object-cover"
                />
              )
            }
            <span class="flex min-w-0 flex-1 flex-col leading-tight">
              <span class="truncate text-[14px] font-medium">{merchantName}</span>
              <span class="truncate text-xs text-sidebar-muted-foreground">Enterprise</span>
            </span>
          </div>
          <button
            type="button"
            data-sidebar-close
            aria-label="Close navigation menu"
            class="inline-flex size-10 items-center justify-center rounded-lg text-sidebar-muted-foreground transition-colors hover:bg-sidebar-accent hover:text-sidebar-foreground md:hidden"
          >
            <XIcon size={22} weight="bold" aria-hidden="true" />
          </button>
          <div class="hidden items-center gap-1 md:flex">
            <SidebarToggle client:load />
          </div>
        </div>

        <SideNav
          pathname={Astro.url.pathname}
          permissions={user.permissions}
          counts={{ "/disputes": openDisputes }}
        />

        <nav
          aria-label="Dashboard utilities"
          data-sidebar-utilities
          class="grid grid-cols-4 justify-items-center gap-1 border-t border-sidebar-border px-3 py-2 [&_button]:border-0 [&_button]:text-sidebar-muted-foreground [&_button:hover]:bg-sidebar-accent [&_button:hover]:text-sidebar-foreground"
        >
          <ThemeToggle client:load />
          <a
            href="/?tour=1"
            aria-label="Take the tour"
            title="Take the tour"
            class="flex size-10 items-center justify-center rounded-lg text-sidebar-muted-foreground transition-colors hover:bg-sidebar-accent hover:text-sidebar-foreground"
          >
            <SignpostIcon size={19} weight="regular" aria-hidden="true" />
          </a>
          {user.permissions.includes("payments:read") && <NotificationBell client:load />}
          <a
            href="/settings"
            aria-label="Open account settings"
            title="Account settings"
            class="flex size-10 items-center justify-center rounded-lg text-sidebar-muted-foreground transition-colors hover:bg-sidebar-accent hover:text-sidebar-foreground"
          >
            <UserIcon size={19} weight="regular" aria-hidden="true" />
          </a>
        </nav>

        <div
          data-sidebar-profile
          class="mt-auto flex items-center gap-3 border-t border-sidebar-border py-2 px-4 md:p-3"
        >
          <img
            src={avatarUrl}
            alt="avatar-url"
            aria-hidden="true"
            width="44"
            height="44"
            data-sidebar-avatar
            class="size-11 shrink-0 rounded-full border border-sidebar-border bg-sidebar-accent object-cover"
          />
          <div data-sidebar-profile-details class="flex min-w-0 flex-1 flex-col gap-0.5">
            <span class="truncate text-sm font-medium text-sidebar-foreground">{user.email}</span>
            <span class="truncate text-xs text-sidebar-muted-foreground">{roleLabel}</span>
          </div>
          <div data-sidebar-logout>
            <LogoutButton client:load />
          </div>
        </div>
      </aside>

      <main
        id="main"
        class="min-w-0 flex-1 overflow-hidden bg-card md:my-4 md:mr-4 md:rounded-2xl md:border md:border-border"
      >
        <header
          class="flex h-16 items-center justify-between gap-x-4 gap-y-2 border-b border-border bg-background px-4 md:hidden"
        >
          <div class="flex items-center">
            <button
              type="button"
              data-sidebar-open
              aria-label="Open navigation menu"
              aria-controls="dashboard-sidebar"
              aria-expanded="false"
              class="inline-flex size-10 items-center justify-center rounded-lg border border-border text-muted-foreground transition-colors hover:bg-muted hover:text-foreground md:hidden"
            >
              <span data-menu-open-icon aria-hidden="true" class="flex w-5 flex-col gap-1">
                <span class="h-0.5 w-full bg-current"></span>
                <span class="h-0.5 w-full bg-current"></span>
              </span>
              <XIcon data-menu-close-icon size={22} weight="bold" aria-hidden="true" />
            </button>
          </div>

          <nav aria-label="Dashboard shortcuts" class="flex items-center gap-2">
            <ThemeToggle client:load />
            <a
              href="/?tour=1"
              aria-label="Take the tour"
              title="Take the tour"
              class="hidden size-10 md:flex items-center justify-center rounded-lg border border-border text-muted-foreground transition-colors duration-200 hover:bg-muted hover:text-foreground"
            >
              <SignpostIcon size={20} weight="regular" aria-hidden="true" />
            </a>
            {user.permissions.includes("payments:read") && <NotificationBell client:load />}
            <a
              href="/settings"
              aria-label="Open account settings"
              title="Account settings"
              class="flex size-10 items-center justify-center rounded-lg border border-border text-muted-foreground transition-colors duration-200 hover:bg-muted hover:text-foreground"
            >
              <UserIcon size={20} weight="regular" aria-hidden="true" />
            </a>
          </nav>
        </header>

        <div class="mx-auto w-full max-w-[106rem] p-4 md:px-8 md:py-7 lg:px-12 lg:py-8 xl:px-14">
          <slot />
        </div>
      </main>
    </div>

    <script>
      const root = document.documentElement;
      const openButton = document.querySelector<HTMLButtonElement>("[data-sidebar-open]");
      const closeButton = document.querySelector<HTMLButtonElement>("[data-sidebar-close]");
      const backdrop = document.querySelector<HTMLButtonElement>("[data-sidebar-backdrop]");
      const testnetNoticeClose = document.querySelector<HTMLButtonElement>(
        "[data-testnet-notice-close]",
      );
      const desktop = window.matchMedia("(min-width: 48rem)");

      function setMobileSidebar(open: boolean) {
        root.dataset.sidebarMobileOpen = String(open);
        openButton?.setAttribute("aria-expanded", String(open));
        openButton?.setAttribute("aria-label", open ? "Close navigation menu" : "Open navigation menu");
        document.body.style.overflow = open ? "hidden" : "";
        if (open) closeButton?.focus();
        else openButton?.focus();
      }

      openButton?.addEventListener("click", () =>
        setMobileSidebar(root.dataset.sidebarMobileOpen !== "true"),
      );
      closeButton?.addEventListener("click", () => setMobileSidebar(false));
      backdrop?.addEventListener("click", () => setMobileSidebar(false));
      testnetNoticeClose?.addEventListener("click", () => {
        localStorage.setItem("mayarin-testnet-notice-v1-dismissed", "true");
        root.dataset.testnetNoticeDismissed = "true";
      });
      desktop.addEventListener("change", ({ matches }) => {
        if (matches && root.dataset.sidebarMobileOpen === "true") setMobileSidebar(false);
      });
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && root.dataset.sidebarMobileOpen === "true") {
          setMobileSidebar(false);
        }
      });
    </script>
  </body>
</html>
