---
/**
 * Authenticated shell: sidebar on desktop, a scrollable rail above the content
 * on narrow viewports. Auth gating itself lives in `src/middleware.ts`; the
 * guard below only narrows `user` for TypeScript.
 */
import { Avatar, Style } from "@dicebear/core";
import loopsDefinition from "@dicebear/styles/loops.json" with { type: "json" };
import {
  BellIcon,
  InfoIcon,
  UserIcon,
  XIcon,
} from "@phosphor-icons/react";
import LogoutButton from "../components/logout-button.tsx";
import LiveUpdates from "../components/live-updates.tsx";
import SearchCommand from "../components/search-command.tsx";
import SidebarToggle from "../components/sidebar-toggle.tsx";
import SideNav from "../components/side-nav.tsx";
import ThemeToggle from "../components/theme-toggle.tsx";
import SocialMeta from "../components/social-meta.astro";
import Toaster from "../components/ui/toaster.tsx";
import "../styles/global.css";
import type { UserDto } from "../types/user";

interface Props {
  title: string;
}

const { title } = Astro.props;

const user: UserDto | undefined = Astro.locals.user;
if (user === undefined) return Astro.redirect("/login");

const isAdmin = user.permissions.includes("admin:access");
const roleLabel = isAdmin ? "Administrator" : "Merchant";
const loopsStyle = new Style(loopsDefinition);
const avatarSvg = new Avatar(loopsStyle, {
  seed: user.email,
  size: 88,
}).toString();

const avatarUrl = `data:image/svg+xml;charset=utf-8,${encodeURIComponent(avatarSvg)}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a0a0a" />
    <title>{title} — Mayarin</title>
    <SocialMeta />
    <link rel="icon" href="/favicon.ico" sizes="48x48" type="image/x-icon" />
    <link rel="icon" href="/favicon-16x16.png" sizes="16x16" type="image/png" />
    <link rel="icon" href="/favicon-32x32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <script is:inline>
      // Before first paint. A stored choice wins; a fresh browser follows the OS.
      const storedTheme = localStorage.getItem("mayarin-theme");
      const systemTheme = window.matchMedia("(prefers-color-scheme: dark)").matches
        ? "dark"
        : "light";
      document.documentElement.dataset.theme =
        storedTheme === "light" || storedTheme === "dark" ? storedTheme : systemTheme;
      document.documentElement.dataset.sidebarCollapsed =
        localStorage.getItem("mayarin-sidebar-collapsed") === "true" ? "true" : "false";
      document.documentElement.dataset.testnetNoticeDismissed =
        localStorage.getItem("mayarin-testnet-notice-v1-dismissed") === "true"
          ? "true"
          : "false";
      document
        .querySelector('meta[name="theme-color"]')
        ?.setAttribute(
          "content",
          document.documentElement.dataset.theme === "light" ? "#ffffff" : "#0a0a0a",
        );
    </script>
  </head>
  <body class="min-h-full">
    <Toaster client:load />
    <LiveUpdates client:load />
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-2 focus:top-2 focus:z-70 focus:bg-primary focus:px-3 focus:py-2 focus:text-sm focus:text-primary-foreground"
    >
      Skip to content
    </a>

    <aside
      data-testnet-notice
      aria-label="Testnet notice"
      class="fixed inset-x-0 top-0 z-60 flex h-11 items-center justify-center border-b border-brand/20 bg-brand-muted px-14 text-brand"
    >
      <p class="flex min-w-0 items-center gap-2 text-center text-xs font-medium sm:text-sm">
        <InfoIcon size={16} weight="bold" aria-hidden="true" className="shrink-0" />
        <span class="truncate">
          <strong class="font-medium">Mayarin Testnet {" "}</strong>
          — Transactions use test assets and have no real-world value.
        </span>
      </p>
      <button
        type="button"
        data-testnet-notice-close
        aria-label="Dismiss testnet notice"
        class="absolute right-0 top-0 flex cursor-pointer size-11 items-center justify-center text-brand/70 transition-colors hover:bg-brand/10 hover:text-brand focus-visible:outline-2 focus-visible:outline-offset-[-3px] focus-visible:outline-ring"
      >
        <XIcon size={17} weight="regular" aria-hidden="true" />
      </button>
    </aside>

    <button
      type="button"
      data-sidebar-backdrop
      class="fixed inset-0 z-40 bg-black/60 md:hidden"
      aria-label="Close navigation menu"
      tabindex="-1"
    ></button>

    <div data-dashboard-frame class="flex min-h-screen pt-11 md:flex-row">
      <!-- The landing's dark tone, brought into the product as its anchor. -->
      <aside
        id="dashboard-sidebar"
        data-sidebar
        data-tone="dark"
        class="fixed top-11 bottom-0 left-0 z-50 flex w-[min(20rem,calc(100vw-3rem))] shrink-0 -translate-x-full flex-col border-r border-sidebar-border bg-sidebar text-sidebar-foreground md:sticky md:top-11 md:h-[calc(100dvh-2.75rem)] md:w-72 md:translate-x-0"
      >
        <div
          data-sidebar-header
          class="flex h-16 items-center justify-between gap-2 border-b border-sidebar-border px-3 md:px-2"
        >
          <a
            href="/"
            data-sidebar-logo
            aria-label="Mayarin dashboard"
            class="flex min-h-11 shrink-0 items-center px-2"
          >
            <!-- Two marks, one per theme. The white one was drawn for the void
                 sidebar and disappears entirely on the light one, so the theme
                 picks rather than a filter inverting a logo into something the
                 brand kit never approved. -->
            <img
              src="https://mayarin.xyz/brand-kit/mayarin-logo-black.svg"
              alt=""
              aria-hidden="true"
              width="44"
              height="44"
              class="size-11 dark:hidden"
            />
            <img
              src="https://mayarin.xyz/brand-kit/mayarin-logo-white.svg"
              alt=""
              aria-hidden="true"
              width="44"
              height="44"
              class="hidden size-11 dark:block"
            />
            <span class="-ml-1 font-sans text-[26px] font-medium leading-none tracking-[-0.06em]">
              mayarin
            </span>
          </a>
          <button
            type="button"
            data-sidebar-close
            aria-label="Close navigation menu"
            class="inline-flex size-10 items-center justify-center rounded-lg text-sidebar-muted-foreground transition-colors hover:bg-sidebar-accent hover:text-sidebar-foreground md:hidden"
          >
            <XIcon size={22} weight="bold" aria-hidden="true" />
          </button>
          <SidebarToggle client:load />
        </div>

        <SideNav pathname={Astro.url.pathname} permissions={user.permissions} />

        <div
          data-sidebar-profile
          class="mt-auto flex items-center gap-3 border-t border-sidebar-border py-1 px-3 md:p-2"
        >
          <img
            src={avatarUrl}
            alt=""
            aria-hidden="true"
            width="44"
            height="44"
            data-sidebar-avatar
            class="size-11 shrink-0 rounded-xs border border-sidebar-border bg-sidebar-accent object-cover"
          />
          <div data-sidebar-profile-details class="flex min-w-0 flex-1 flex-col gap-0.5">
            <span class="truncate text-sm font-medium text-sidebar-foreground">{user.email}</span>
            <span class="truncate text-xs text-sidebar-muted-foreground">{roleLabel}</span>
          </div>
          <div data-sidebar-logout>
            <LogoutButton client:load />
          </div>
        </div>
      </aside>

      <main id="main" class="min-w-0 flex-1">
        <header
          class="flex h-16 items-center justify-between gap-4 border-border bg-background px-4 md:border-b md:px-8 lg:px-10"
        >
          <div class="flex items-center gap-3">
            <button
              type="button"
              data-sidebar-open
              aria-label="Open navigation menu"
              aria-controls="dashboard-sidebar"
              aria-expanded="false"
              class="inline-flex size-10 items-center justify-center rounded-lg border border-border text-muted-foreground transition-colors hover:bg-muted hover:text-foreground md:hidden"
            >
              <span data-menu-open-icon aria-hidden="true" class="flex w-5 flex-col gap-1">
                <span class="h-0.5 w-full bg-current"></span>
                <span class="h-0.5 w-full bg-current"></span>
              </span>
              <XIcon data-menu-close-icon size={22} weight="bold" aria-hidden="true" />
            </button>
            <SearchCommand client:load permissions={user.permissions} />
          </div>

          <nav aria-label="Dashboard shortcuts" class="flex items-center gap-2">
            <ThemeToggle client:load />
            <a
              href="/event-logs"
              aria-label="Open notifications"
              title="Notifications"
              class="flex size-10 items-center justify-center rounded-lg border border-border text-muted-foreground transition-colors duration-200 hover:bg-muted hover:text-foreground"
            >
              <BellIcon size={20} weight="regular" aria-hidden="true" />
            </a>
            <a
              href="/settings"
              aria-label="Open account settings"
              title="Account settings"
              class="flex size-10 items-center justify-center rounded-lg border border-border text-muted-foreground transition-colors duration-200 hover:bg-muted hover:text-foreground"
            >
              <UserIcon size={20} weight="regular" aria-hidden="true" />
            </a>
          </nav>
        </header>

        <div class="w-full gap-8 p-4 md:p-8 lg:pt-5 lg:px-10">
          <slot />
        </div>
      </main>
    </div>

    <script>
      const root = document.documentElement;
      const openButton = document.querySelector<HTMLButtonElement>("[data-sidebar-open]");
      const closeButton = document.querySelector<HTMLButtonElement>("[data-sidebar-close]");
      const backdrop = document.querySelector<HTMLButtonElement>("[data-sidebar-backdrop]");
      const testnetNoticeClose = document.querySelector<HTMLButtonElement>(
        "[data-testnet-notice-close]",
      );
      const desktop = window.matchMedia("(min-width: 48rem)");

      function setMobileSidebar(open: boolean) {
        root.dataset.sidebarMobileOpen = String(open);
        openButton?.setAttribute("aria-expanded", String(open));
        openButton?.setAttribute("aria-label", open ? "Close navigation menu" : "Open navigation menu");
        document.body.style.overflow = open ? "hidden" : "";
        if (open) closeButton?.focus();
        else openButton?.focus();
      }

      openButton?.addEventListener("click", () =>
        setMobileSidebar(root.dataset.sidebarMobileOpen !== "true"),
      );
      closeButton?.addEventListener("click", () => setMobileSidebar(false));
      backdrop?.addEventListener("click", () => setMobileSidebar(false));
      testnetNoticeClose?.addEventListener("click", () => {
        localStorage.setItem("mayarin-testnet-notice-v1-dismissed", "true");
        root.dataset.testnetNoticeDismissed = "true";
      });
      desktop.addEventListener("change", ({ matches }) => {
        if (matches && root.dataset.sidebarMobileOpen === "true") setMobileSidebar(false);
      });
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && root.dataset.sidebarMobileOpen === "true") {
          setMobileSidebar(false);
        }
      });
    </script>
  </body>
</html>
