---
import "../styles/global.css";
import AuthPixelField from "../components/auth-pixel-field.tsx";
import ThemeToggle from "../components/theme-toggle.tsx";
// Auth layout: for the login page. A logged-in user has no business here.
if (Astro.locals.user !== undefined) return Astro.redirect("/");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a0a0a" />
    <title>Sign in — Mayarin</title>
    <link rel="icon" href="/favicon.ico" sizes="48x48" type="image/x-icon" />
    <link rel="icon" href="/favicon-16x16.png" sizes="16x16" type="image/png" />
    <link rel="icon" href="/favicon-32x32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter+Tight:wght@400;500&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <script is:inline>
      // Before first paint. Dark is the default; "light" is the stored opt-out.
      document.documentElement.dataset.theme =
        localStorage.getItem("mayarin-theme") === "light" ? "light" : "dark";
      document
        .querySelector('meta[name="theme-color"]')
        ?.setAttribute(
          "content",
          document.documentElement.dataset.theme === "light" ? "#ffffff" : "#0a0a0a",
        );
    </script>
  </head>
  <body class="min-h-full bg-background">
    <main class="grid min-h-svh md:grid-cols-2">
      <section
        aria-label="Mayarin"
        class="auth-brand-panel relative flex min-h-72 overflow-hidden border-border border-b bg-background p-6 md:min-h-svh md:border-r md:border-b-0 md:p-10 lg:p-14"
      >
        <AuthPixelField client:load />
        <div class="relative z-10 flex w-full flex-col justify-between">
          <a href="https://mayarin.xyz" aria-label="Mayarin home" class="inline-flex w-fit">
            <img
              src="/images/mayarin-full-black.png"
              alt="Mayarin"
              width="571"
              height="186"
              class="auth-logo auth-logo-light h-auto w-36"
            />
            <img
              src="/images/mayarin-full-white.png"
              alt=""
              width="571"
              height="186"
              class="auth-logo auth-logo-dark h-auto w-36"
            />
          </a>

          <p class="auth-tagline max-w-[17ch] text-[clamp(2rem,4vw,3.5rem)] leading-[0.98] tracking-[-0.035em]">
            Clearing infrastructure for money <em class="italic">in motion</em>.
          </p>
        </div>
      </section>

      <section class="relative flex min-h-[32rem] items-center justify-center bg-background px-5 py-16 sm:px-10 md:min-h-svh lg:px-16">
        <div class="absolute top-5 right-5 md:top-8 md:right-8">
          <ThemeToggle client:load />
        </div>
        <slot />
      </section>
    </main>

  </body>
</html>

<style>
  .auth-tagline em {
    font-family: "Instrument Serif", Georgia, serif;
  }

  .auth-logo-dark {
    display: none;
  }

  :global(:root[data-theme="dark"]) .auth-logo-light {
    display: none;
  }

  :global(:root[data-theme="dark"]) .auth-logo-dark {
    display: block;
  }
</style>
