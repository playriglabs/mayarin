---
import "../styles/global.css";
// Auth layout: for the login page. A logged-in user has no business here.
if (Astro.locals.user !== undefined) return Astro.redirect("/");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sign in — Mayarin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <script is:inline>
      // Before first paint. Dark is the default; "light" is the stored opt-out.
      document.documentElement.dataset.theme =
        localStorage.getItem("mayarin-theme") === "light" ? "light" : "dark";
    </script>
  </head>
  <!-- The landing's dark tone: a paper card floating on the void. -->
  <body class="flex min-h-full items-center justify-center bg-sidebar px-4 py-12">
    <slot />
  </body>
</html>
