{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mayarin-dashboard-testnet",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],

  // Deployed as a Worker with static assets, not to Pages. `@astrojs/cloudflare`
  // dropped Pages in v12, and v14 is what Astro 7 requires: the build emits
  // `dist/server/wrangler.json` with `main` and an `assets` binding named
  // ASSETS — a name Pages reserves, so `wrangler pages deploy` refuses it and
  // always will. `main` and `assets` are not repeated here; the adapter writes
  // them, and this file is merged into what it writes.

  // A Worker declares its own bindings. On Pages these were configured in the
  // Cloudflare dashboard and inherited invisibly; here the namespace id has to
  // be named, and `wrangler kv namespace list` is where it comes from. Without
  // it every session is dropped on deploy — a silent logout for every merchant.
  "kv_namespaces": [{ "binding": "SESSION", "id": "0f488c4fdbd1417a8c680ed5d53267e3" }],
  "images": { "binding": "IMAGES" },

  // The dashboard API's ORIGIN hostname, not its public one.
  //
  // This Worker is attached by a zone route (`zone_name` below), so it runs
  // inside `mayarin.xyz`'s routing. A subrequest from here to another proxied
  // hostname in the same zone loops back into that routing and Cloudflare
  // answers it with error 1003, "Direct IP access not allowed" — which the
  // `/api/*` proxy then passes through verbatim, so every dashboard API call
  // returned a 403 HTML page and the browser reported "Invalid JSON response".
  //
  // `api-merchant-testnet.mayarin.xyz` still serves every external caller. Only
  // this internal hop changes, to the hostname Railway gives the service, which
  // is outside our zone and therefore not a loopback. The sibling pay-proxy
  // avoids the same trap a different way: it is bound by `custom_domain`, which
  // is not attached to the zone route table. Moving this Worker to a custom
  // domain is the tidier fix and a riskier one — it rewrites the live DNS
  // record for a hostname that is currently serving.
  "vars": {
    "API_URL": "https://dashboard-api-production-7a49.up.railway.app"
  },

  // A route, not a custom domain: the hostname is still attached to the old
  // Pages project, and a custom domain refuses a hostname that another project
  // or a DNS record already holds. A route runs in front of the proxied CNAME,
  // so the Worker takes the traffic without detaching Pages first.
  "routes": [{ "pattern": "dashboard-testnet.mayarin.xyz/*", "zone_name": "mayarin.xyz" }]
}
