{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mayarin-dashboard-testnet",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],

  // Deployed as a Worker with static assets, not to Pages. `@astrojs/cloudflare`
  // dropped Pages in v12, and v14 is what Astro 7 requires: the build emits
  // `dist/server/wrangler.json` with `main` and an `assets` binding named
  // ASSETS — a name Pages reserves, so `wrangler pages deploy` refuses it and
  // always will. `main` and `assets` are not repeated here; the adapter writes
  // them, and this file is merged into what it writes.

  // A Worker declares its own bindings. On Pages these were configured in the
  // Cloudflare dashboard and inherited invisibly; here the namespace id has to
  // be named, and `wrangler kv namespace list` is where it comes from. Without
  // it every session is dropped on deploy — a silent logout for every merchant.
  "kv_namespaces": [{ "binding": "SESSION", "id": "0f488c4fdbd1417a8c680ed5d53267e3" }],
  "images": { "binding": "IMAGES" },

  // Back on our own hostname, now that this Worker is bound by a custom domain
  // rather than a zone route.
  //
  // A zone-route Worker runs inside the zone's routing, so this subrequest
  // looped back and Cloudflare answered error 1003 — which is what took every
  // `/api/*` call down between 11 and 13 September. It was pointed at Railway's
  // own hostname to escape that loop, at the cost of leaving Cloudflare's
  // network for every SSR session check and every proxied call: roughly 200ms
  // per request, paid on every page load for a signed-in merchant.
  "vars": {
    "API_URL": "https://api-merchant-testnet.mayarin.xyz"
  },

  // A route, not a custom domain: the hostname is still attached to the old
  // Pages project, and a custom domain refuses a hostname that another project
  // or a DNS record already holds. A route runs in front of the proxied CNAME,
  // so the Worker takes the traffic without detaching Pages first.
  // A custom domain, not a zone route.
  //
  // A Worker bound by a zone route runs inside that zone's routing, so a
  // subrequest from it to another proxied hostname in the same zone loops back
  // and Cloudflare answers error 1003 — which is what took every `/api/*` call
  // down between 11 and 13 September. A custom domain is not attached to the
  // zone route table, so the same subrequest resolves normally. The sibling
  // pay-proxy has always been bound this way and never hit the trap.
  //
  // This needs the hostname to carry no hand-managed DNS record: Cloudflare
  // refuses to create the domain otherwise (error 100117), and wrangler manages
  // the record itself once it owns the hostname.
  "routes": [{ "pattern": "dashboard-testnet.mayarin.xyz", "custom_domain": true }]
}
