{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // The mainnet pay host. Deployed with `-c wrangler.mainnet.jsonc`; the default
  // wrangler.jsonc is testnet and must never be what this Worker is published from.
  "name": "mayarin-pay",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-11",
  "vars": {
    "ORIGIN": "https://api.mayarin.xyz"
  },
  "routes": [{ "pattern": "pay.mayarin.xyz", "custom_domain": true }]
}
