{
  "name": "mayarin",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/core/*",
    "packages/providers/*"
  ],
  "engines": {
    "bun": ">=1.2.0"
  },
  "packageManager": "bun@1.2.5",
  "scripts": {
    "prepare": "lefthook install",
    "dev": "bun run --cwd apps/api dev",
    "dev:all": "turbo dev --filter=@mayarin/api --filter=@mayarin/dashboard-api --filter=@mayarin/dashboard",
    "dev:landing": "bun run --cwd apps/landing dev",
    "build:landing": "bun run --cwd apps/landing build",
    "dev:blog": "bun run --cwd apps/blog dev",
    "build:blog": "bun run --cwd apps/blog build",
    "dev:studio": "bun run --cwd apps/studio dev",
    "build:studio": "bun run --cwd apps/studio build",
    "deploy:studio": "bun run --cwd apps/studio deploy",
    "dev:content": "turbo dev --filter=@mayarin/blog --filter=@mayarin/studio",
    "test": "bun test",
    "typecheck": "turbo typecheck",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "format": "biome check --write && prettier --write \"**/*.{md,yml,yaml}\"",
    "format:check": "biome check && prettier --check \"**/*.{md,yml,yaml}\"",
    "check": "bun run format:check && bun run typecheck && bun test",
    "db:generate": "bun run --cwd packages/db generate",
    "db:migrate": "bun run --cwd packages/db migrate",
    "db:studio": "bun run --cwd packages/db studio",
    "seed:merchant": "bun --env-file=../../.env run --cwd apps/dashboard-api scripts/seed-merchant.ts",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/bun": "^1.2.5",
    "lefthook": "^2.1.10",
    "prettier": "^3.9.6",
    "turbo": "^2.10.8",
    "typescript": "^5.7.3"
  }
}
